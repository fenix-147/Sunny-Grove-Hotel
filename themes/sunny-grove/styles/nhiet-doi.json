{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Nhiệt đới (cũ)",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "sand", "name": "Cát (nền sáng)", "color": "#F7F1E6" },
				{ "slug": "sand-deep", "name": "Cát đậm (nền khối xen kẽ)", "color": "#EFE5D3" },
				{ "slug": "white", "name": "Trắng", "color": "#FFFFFF" },
				{ "slug": "primary", "name": "Xanh ngọc đậm (nút, chữ nhấn)", "color": "#0E6666" },
				{ "slug": "primary-dark", "name": "Xanh ngọc rất đậm (khi rê chuột)", "color": "#0A4C4C" },
				{ "slug": "secondary", "name": "Xanh ngọc biển (chỉ trang trí)", "color": "#1FA3A3" },
				{ "slug": "accent", "name": "Cam đất (vế nghiêng, giá ưu đãi)", "color": "#A8501F" },
				{ "slug": "peach", "name": "Vàng nắng (vế nghiêng trên nền tối)", "color": "#F6B93B" },
				{ "slug": "ink", "name": "Chữ đậm", "color": "#1E2A2B" },
				{ "slug": "muted", "name": "Chữ phụ", "color": "#3D4A4B" },
				{ "slug": "line", "name": "Viền", "color": "#E3D8C4" },
				{ "slug": "line-soft", "name": "Viền nhạt", "color": "#EFE5D3" },
				{ "slug": "gold", "name": "Vàng đồng (nhãn Nhóm bạn – chữ trắng)", "color": "#8A6A1F" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Lora (tiêu đề)",
					"fontFamily": "Lora, Georgia, 'Times New Roman', serif",
					"fontFace": [
						{ "fontFamily": "Lora", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-vietnamese-wght-normal.woff2" ], "unicodeRange": "U+0102-0103, U+0110-0111, U+0128-0129, U+0168-0169, U+01A0-01A1, U+01AF-01B0, U+0300-0301, U+0303-0304, U+0308-0309, U+0323, U+0329, U+1EA0-1EF9, U+20AB" },
						{ "fontFamily": "Lora", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-latin-ext-wght-normal.woff2" ], "unicodeRange": "U+0100-0101, U+0104-010F, U+0112-0127, U+012A-0167, U+016A-019F, U+01A2-01AE, U+01B1-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+1D00-1DBF, U+1E00-1E9F, U+1EFA-1EFF, U+2020, U+20A0-20AA, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF" },
						{ "fontFamily": "Lora", "fontWeight": "400 700", "fontStyle": "normal", "fontDisplay": "swap", "src": [ "file:./assets/fonts/lora-latin-wght-normal.woff2" ], "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD" }
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Dòng nhỏ trên tiêu đề (chữ hoa)", "size": "0.75rem", "fluid": { "min": "0.6875rem", "max": "0.75rem" } },
				{ "slug": "small", "name": "Chú thích", "size": "0.9375rem", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "medium", "name": "Nội dung", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Đoạn dẫn", "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "x-large", "name": "Tên phòng, tên địa điểm", "size": "1.625rem", "fluid": { "min": "1.5rem", "max": "1.625rem" } },
				{ "slug": "xx-large", "name": "Tiêu đề khối", "size": "2.75rem", "fluid": { "min": "2.1rem", "max": "3.25rem" } },
				{ "slug": "huge", "name": "Tiêu đề hero", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
			]
		},
		"custom": {
			"radius": { "small": "10px", "medium": "16px", "large": "28px", "pill": "999px", "arch": "28px" }
		}
	},
	"styles": {
		"elements": {
			"button": {
				"color": { "background": "#F6B93B", "text": "var(--wp--preset--color--ink)" },
				":hover": { "color": { "background": "#D99A1E", "text": "var(--wp--preset--color--ink)" } }
			}
		}
	}
}
