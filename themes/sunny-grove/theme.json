				{ "slug": "small", "name": "Chú thích", "size": "0.9375rem", "fluid": { "min": "0.875rem", "max": "0.9375rem" } },
				{ "slug": "medium", "name": "Nội dung", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "Đoạn dẫn", "size": "1.1875rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "x-large", "name": "Tên phòng, tên địa điểm", "size": "1.875rem", "fluid": { "min": "1.75rem", "max": "1.875rem" } },
				{ "slug": "xx-large", "name": "Tiêu đề khối", "size": "3.625rem", "fluid": { "min": "2.375rem", "max": "3.625rem" } },
				{ "slug": "huge", "name": "Tiêu đề hero", "size": "5.25rem", "fluid": { "min": "2.625rem", "max": "5.25rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "2XS", "size": "0.5rem" },
				{ "slug": "30", "name": "XS", "size": "clamp(0.75rem, 1.5vw, 1rem)" },
				{ "slug": "40", "name": "S", "size": "clamp(1rem, 2.2vw, 1.5rem)" },
				{ "slug": "50", "name": "M", "size": "clamp(1.5rem, 3.2vw, 2.5rem)" },
				{ "slug": "60", "name": "L", "size": "clamp(2rem, 4vw, 3.5rem)" },
				{ "slug": "70", "name": "Khoảng cách giữa các khối", "size": "clamp(4rem, 9vw, 8.125rem)" },
				{ "slug": "80", "name": "2XL", "size": "clamp(5rem, 11vw, 10rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "float", "name": "Nổi (chỉ cho thanh đặt phòng)", "shadow": "0 24px 60px rgba(38, 37, 31, 0.12)" }
			]
		},
		"custom": {
			"radius": { "small": "14px", "medium": "20px", "large": "24px", "pill": "999px", "arch": "200px 200px 20px 20px" },
			"headerHeight": "96px",
			"headerHeightMobile": "72px",
			"motion": { "ease": "cubic-bezier(.22, .61, .36, 1)", "duration": "0.9s" },
			"link": { "color": "var(--wp--preset--color--primary)" },
			"eyebrow": { "color": "var(--wp--preset--color--primary)" },
			"emphasis": { "color": "var(--wp--preset--color--accent)", "onDark": "var(--wp--preset--color--peach)" },
			"text": { "muted": "var(--wp--preset--color--muted)" }
		},
		"blocks": {
			"core/button": { "border": { "radius": true } }
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--sand)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "500",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1.25rem, 4vw, 3rem)",
				"right": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--custom--link--color)" },
				"typography": { "textDecoration": "none" },
				":hover": { "color": { "text": "var(--wp--preset--color--ink)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--primary)", "offset": "3px", "style": "solid", "width": "2px" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600", "lineHeight": "1.08", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.02" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.3" } },
			"button": {
