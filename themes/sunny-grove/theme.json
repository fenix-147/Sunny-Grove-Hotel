			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "sand", "name": "Kem (nền chính)", "color": "#F8F5EF" },
				{ "slug": "sand-deep", "name": "Lanh (nền khối xen kẽ)", "color": "#EFE9DF" },
				{ "slug": "white", "name": "Trắng", "color": "#FFFFFF" },
				{ "slug": "primary", "name": "Rêu đậm (nút chính, chữ nhấn, dòng nhỏ trên tiêu đề)", "color": "#3F5B4B" },
				{ "slug": "primary-dark", "name": "Rêu đậm khi rê chuột", "color": "#2F4639" },
				{ "slug": "secondary", "name": "Xô thơm (chỉ trang trí, nền lớn – không dùng cho chữ)", "color": "#8AA190" },
				{ "slug": "accent", "name": "Đất nung (vế nghiêng, giá ưu đãi – chữ trên nền kem/trắng; làm nền thì chữ trắng)", "color": "#9C5A3C" },
				{ "slug": "peach", "name": "Đào nhạt (vế nghiêng trên nền tối/ảnh)", "color": "#F1DDCB" },
				{ "slug": "ink", "name": "Than ấm (chữ chính, nền khối tối)", "color": "#26251F" },
				{ "slug": "muted", "name": "Chữ phụ", "color": "#46423B" },
				{ "slug": "line", "name": "Viền", "color": "#DDD5C8" },
				{ "slug": "line-soft", "name": "Viền nhạt", "color": "#ECE6DC" }
			],
			"gradients": [
				{ "slug": "hero-fade", "name": "Phủ ảnh: tối dần xuống dưới", "gradient": "linear-gradient(180deg, rgba(20,22,18,.45) 0%, rgba(20,22,18,.05) 30%, rgba(20,22,18,.15) 55%, rgba(20,22,18,.72) 100%)" },
				{ "slug": "linen", "name": "Kem sang lanh", "gradient": "linear-gradient(180deg, var(--wp--preset--color--sand) 0%, var(--wp--preset--color--sand-deep) 100%)" }
			]
		},
