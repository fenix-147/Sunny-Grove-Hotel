{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "primary", "name": "Xanh ngọc biển (chính)", "color": "#1FA3A3" },
				{ "slug": "secondary", "name": "Xanh lá vườn (phụ)", "color": "#5E9C76" },
				{ "slug": "accent", "name": "Vàng nắng (nút đặt phòng)", "color": "#F6B93B" },
				{ "slug": "sand", "name": "Cát (nền sáng)", "color": "#F7F1E6" },
				{ "slug": "sand-deep", "name": "Cát đậm (nền khối xen kẽ)", "color": "#EFE5D3" },
				{ "slug": "ink", "name": "Chữ đậm", "color": "#1E2A2B" },
				{ "slug": "white", "name": "Trắng", "color": "#FFFFFF" }
			],
			"gradients": [
				{ "slug": "lagoon", "name": "Biển chiều", "gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--secondary) 100%)" },
				{ "slug": "sunrise", "name": "Nắng sớm", "gradient": "linear-gradient(180deg, var(--wp--preset--color--sand) 0%, var(--wp--preset--color--white) 100%)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Lora (tiêu đề)",
					"fontFamily": "Lora, Georgia, 'Times New Roman', serif",
					"fontFace": [
