{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sunny-grove/reviews",
	"title": "Đánh giá khách hàng",
	"category": "sunny-grove",
	"icon": "star-filled",
	"description": "Tối đa 3 đánh giá Google Maps chọn ở menu Đánh giá (nguyên văn, có link tới đánh giá gốc), kèm điểm trung bình và link xem tất cả / viết đánh giá.",
	"keywords": [ "review", "đánh giá", "testimonial", "google maps" ],
	"textdomain": "sunny-grove-core",
	"attributes": {
		"count": { "type": "number", "default": 3 },
		"source": { "type": "string", "default": "" },
		"minRating": { "type": "number", "default": 0 },
		"layout": { "type": "string", "default": "google", "enum": [ "google", "grid", "slider" ] },
		"interval": { "type": "number", "default": 7 }
	},
	"supports": { "html": false, "align": [ "wide", "full" ], "spacing": { "margin": true } },
	"editorScript": "sgc-blocks-editor",
	"viewScript": "sgc-blocks-view",
	"style": "sgc-blocks",
	"render": "file:./render.php"
}
