{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sunny-grove/media-gallery",
	"title": "Thư viện ảnh/video thực tế",
	"category": "sunny-grove",
	"icon": "format-gallery",
	"description": "Hiển thị thư viện ảnh/video đã chọn trong trường “Thư viện ảnh / video thực tế” của phòng hoặc tiện ích.",
	"textdomain": "sunny-grove-core",
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"layout": { "type": "string", "default": "grid", "enum": [ "grid", "scroller" ] },
		"max": { "type": "number", "default": 8 },
		"showTitle": { "type": "boolean", "default": false }
	},
	"supports": { "html": false, "align": [ "wide", "full" ], "spacing": { "margin": true } },
	"editorScript": "sgc-blocks-editor",
	"style": "sgc-blocks",
	"viewScript": "sgc-blocks-view",
	"render": "file:./render.php"
}
