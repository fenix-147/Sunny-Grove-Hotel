{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sunny-grove/menu",
	"title": "Menu song ngữ",
	"category": "sunny-grove",
	"icon": "menu",
	"description": "Hiển thị menu tại vị trí đã chọn (Giao diện → Menu). Bản EN tự dùng \"Tên tiếng Anh\" của từng mục menu. Trên điện thoại có nút mở menu.",
	"textdomain": "sunny-grove-core",
	"attributes": {
		"location": { "type": "string", "default": "primary" },
		"mobileToggle": { "type": "boolean", "default": true }
	},
	"supports": { "html": false, "spacing": { "margin": true } },
	"editorScript": "sgc-blocks-editor",
	"style": "sgc-blocks",
	"viewScript": "sgc-blocks-view",
	"render": "file:./render.php"
}
