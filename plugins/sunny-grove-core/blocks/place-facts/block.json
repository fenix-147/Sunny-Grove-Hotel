{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "sunny-grove/place-facts",
	"title": "Khoảng cách & chỉ đường",
	"category": "sunny-grove",
	"icon": "location",
	"description": "Khoảng cách (km), thời gian và phương tiện di chuyển, dòng so sánh vui và nút mở Google Maps của địa điểm.",
	"textdomain": "sunny-grove-core",
